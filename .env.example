# ---------------------------------------------------------------------------
# Gridhub environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (safe to expose: this is the publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=https://nzcwmarlkdmgssrllsqn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QBzDRfpYlZTwvzdKKipDZA_YmiE6_-i

# Server-only. Required for account deletion and webhook writes. NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# App
# Local default for development; production is https://gridhub.online
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@gridhub.online

# Journal machine translations (server-only; enable Cloud Translation API in Google Cloud first)
GOOGLE_TRANSLATE_API_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs — create these in the Stripe dashboard, then paste the IDs
STRIPE_PRICE_SINGLE_MONTHLY=
STRIPE_PRICE_SINGLE_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_ANNUAL=

# Signs the 7-day offline entitlement grant. Any long random string.
ENTITLEMENT_SIGNING_SECRET=

# Comma-separated additional operator allowlist for /admin. The owner account is built in.
ADMIN_EMAILS=

# Optional: food database integration. Without it, users add custom foods.
USDA_FOODDATA_API_KEY=

# ---------------------------------------------------------------------------
# Gridhub AI (on-device assistant)
#
# All of these are public build-time values. Nothing here is a secret: inference runs in the
# browser and there is no provider API key by design.
# ---------------------------------------------------------------------------

# Set to "false" to hide the assistant entirely for a deployment.
NEXT_PUBLIC_GRIDHUB_AI_ENABLED=true

# The .litertlm artifact. Defaults to the R2 object; override to ship a different build.
NEXT_PUBLIC_GRIDHUB_AI_MODEL_URL=https://pub-610daaff40ac42f18aa2de55bc3970b2.r2.dev/models/gemma-4-E2B-it-web.litertlm

# Bump when the model file changes so installed clients are asked to download again.
NEXT_PUBLIC_GRIDHUB_AI_MODEL_VERSION=1

# Speech model. Multilingual by default; an ".en" checkpoint is smaller but single-language.
NEXT_PUBLIC_GRIDHUB_STT_MODEL_URL=Xenova/whisper-tiny
NEXT_PUBLIC_GRIDHUB_STT_MODEL_VERSION=1

# Default prompt/speech language (BCP-47 primary subtag).
NEXT_PUBLIC_GRIDHUB_AI_DEFAULT_LOCALE=en

# Runtime asset locations. These are served from /public/ai by scripts/vendor-ai-assets.mjs and
# cached by the service worker. Only change them if you host the assets elsewhere.
NEXT_PUBLIC_GRIDHUB_AI_WASM_PATH=/ai/wasm
NEXT_PUBLIC_GRIDHUB_STT_LIBRARY_URL=/ai/transformers/transformers.min.js
NEXT_PUBLIC_GRIDHUB_STT_ORT_PATH=/ai/ort/
